# Clé API Anthropic (analyse IA des montres)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Clé API Resend (envoi email formulaire contact — https://resend.com/api-keys)
# Sans cette clé, le formulaire contact retourne une erreur 500 explicite (pas de crash).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Analytics 4 — laisser vide pour désactiver GA en local.
# Renseigner l'ID de mesure en production (format G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
