# Clé API Anthropic (analyse IA des montres)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Clé API Resend (envoi email formulaire contact — https://resend.com/api-keys)
# Sans cette clé, le formulaire contact retourne une erreur 500 explicite (pas de crash).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Boîte de réception des demandes du formulaire (défaut Gmail dans le code).
# Basculer vers contact@vwion.ch le jour où la boîte pro est active — sans changer le code.
CONTACT_INBOX=kacinr1@gmail.com

# Expéditeur des emails (doit être sur un domaine VÉRIFIÉ dans Resend).
# Défaut : noreply@send.vwion.ch (sous-domaine à vérifier dans Resend).
CONTACT_FROM=VWION Contact <noreply@send.vwion.ch>

# Google Analytics 4 — laisser vide pour désactiver GA en local.
# Renseigner l'ID de mesure en production (format G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
